{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firma2.local/ontology/schema.json",
  "title": "Firma2 Evidence-First Entity Graph Ontology",
  "description": "Query-driven graph contract for entity identity, regulatory evidence, provenance, and temporal relationships.",
  "version": "0.2.0",
  "node_types": {
    "Organisation": {
      "key": "entity_key",
      "required": ["entity_key", "canonical_name"],
      "properties": {
        "entity_key": {"type": "string", "examples": ["abn:51824753556", "acn:123456789"]},
        "canonical_name": {"type": "string"},
        "abn": {"type": ["string", "null"]},
        "acn": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "state": {"type": ["string", "null"]},
        "anzsic": {"type": ["string", "null"]},
        "valid_from": {"type": ["string", "null"], "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"}
      }
    },
    "Person": {
      "key": "entity_key",
      "required": ["entity_key", "canonical_name"],
      "properties": {
        "entity_key": {"type": "string"},
        "canonical_name": {"type": "string"},
        "given_name": {"type": ["string", "null"]},
        "family_name": {"type": ["string", "null"]},
        "date_of_birth": {"type": ["string", "null"], "format": "date"}
      }
    },
    "Licence": {
      "key": "licence_key",
      "required": ["licence_key", "licence_type"],
      "properties": {
        "licence_key": {"type": "string"},
        "licence_type": {"type": "string"},
        "licence_number": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "valid_from": {"type": ["string", "null"], "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"}
      }
    },
    "RegulatoryAction": {
      "key": "action_key",
      "required": ["action_key", "action_type"],
      "properties": {
        "action_key": {"type": "string"},
        "action_type": {"type": "string"},
        "jurisdiction": {"type": ["string", "null"]},
        "valid_from": {"type": ["string", "null"], "format": "date"},
        "valid_to": {"type": ["string", "null"], "format": "date"}
      }
    },
    "SourceDefinition": {
      "key": "source_id",
      "required": ["source_id", "metadata"],
      "properties": {"source_id": {"type": "string"}, "metadata": {"type": "object"}}
    },
    "Observation": {
      "key": "observation_id",
      "required": ["observation_id", "source_id", "source_record_id"],
      "properties": {
        "observation_id": {"type": "string"},
        "source_id": {"type": "string"},
        "source_record_id": {"type": "string"},
        "payload": {"type": "object"},
        "observed_at": {"type": ["string", "null"], "format": "date-time"},
        "ingested_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "Evidence": {
      "key": "evidence_id",
      "required": ["evidence_id", "evidence_type", "source_id"],
      "properties": {
        "evidence_id": {"type": "string"},
        "evidence_type": {"type": "string"},
        "source_id": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "payload": {"type": "object"}
      }
    },
    "ResolutionMatch": {
      "key": "match_id",
      "required": ["match_id", "canonical_key", "match_type", "confidence", "evidence"],
      "properties": {
        "match_id": {"type": "string"},
        "canonical_key": {"type": "string"},
        "match_type": {"enum": ["exact_identifier", "exact_name", "semantic_name"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "minItems": 1}
      }
    }
  },
  "relationship_types": {
    "HAS_SOURCE": {"from": "Organisation", "to": "SourceDefinition", "evidence_required": true},
    "HAS_OBSERVATION": {"from": "SourceDefinition", "to": "Observation", "evidence_required": true},
    "SUPPORTS_ENTITY": {"from": "Observation", "to": "Organisation", "evidence_required": true},
    "HAS_EVIDENCE": {"from": "Organisation", "to": "Evidence", "evidence_required": true},
    "HAS_RESOLUTION_EVIDENCE": {"from": "Organisation", "to": "ResolutionMatch", "evidence_required": true},
    "HAS_LICENCE": {"from": "Organisation", "to": "Licence", "evidence_required": true},
    "HAS_PARENT": {"from": "Organisation", "to": "Organisation", "evidence_required": true},
    "IS_SUBJECT_OF": {"from": ["Organisation", "Person"], "to": "RegulatoryAction", "evidence_required": true},
    "IS_OFFICER_OF": {"from": "Person", "to": "Organisation", "evidence_required": true}
  },
  "reified_relationships": {
    "OwnershipRelation": {"properties": ["ownership_percent", "valid_from", "valid_to", "confidence", "evidence_id"]},
    "LicenceStatus": {"properties": ["status", "valid_from", "valid_to", "evidence_id"]},
    "BanStatus": {"properties": ["ban_type", "valid_from", "valid_to", "reason", "evidence_id"]}
  },
  "invariants": [
    "A canonical identity merge requires evidence and is reversible by retaining source observations and link decisions.",
    "Conflicting populated identifiers prevent automatic linking.",
    "Uncertain matches are abstentions, not inferred graph edges.",
    "Validity time is distinct from observation and ingestion time.",
    "Shared source provenance does not imply common identity, ownership, or control."
  ],
  "extension_points": {
    "new_node_type": "Add a keyed node type with identity, provenance, and temporal semantics documented.",
    "new_relationship_type": "Add explicit endpoint types and evidence requirements before ingestion.",
    "source_specific_fields": "Preserve source-specific details inside Observation payloads; promote fields only when query needs justify it."
  }
}